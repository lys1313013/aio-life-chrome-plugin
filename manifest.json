{
  "manifest_version": 3,
  "name": "aiolife for Chrome",
  "version": "1.1.0",
  "description": "AIO Life 浏览器助手：B 站收藏、豆瓣书影音一键入库、京东淘宝订单录入。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.bilibili.com/video/*",
    "https://api.bilibili.com/x/web-interface/view*",
    "https://aiolife.top/*"
  ],
  "action": {
    "default_title": "aiolife",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
